<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>Tradehub — Cart</title>
<link rel="stylesheet" href="/css/style.css"/>
<style>
  .cart-header {
    padding: 16px; background: var(--surface); border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 12px; flex-shrink: 0;
  }
  .cart-header .back-btn { display: flex; }
  .cart-header h1 { font-size: 17px; font-weight: 800; color: var(--text); flex: 1; }
  .cart-header .item-count { font-size: 12.5px; color: var(--text-dim); }

  .cart-body { flex: 1; padding: 14px 16px 16px; overflow-y: auto; }

  .cart-item {
    display: flex; gap: 12px; background: var(--surface);
    border-radius: var(--r-lg); padding: 12px; margin-bottom: 10px;
    box-shadow: 0 1px 4px rgba(20,30,50,.05);
  }
  .cart-thumb {
    width: 66px; height: 66px; border-radius: var(--r-sm);
    background: linear-gradient(160deg, #dde6f0, #c5d4e6);
    flex-shrink: 0; overflow: hidden;
  }
  .cart-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .cart-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .cart-name {
    font-size: 12.5px; font-weight: 700; color: var(--text); line-height: 1.35;
    margin-bottom: 3px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .cart-seller { font-size: 10.5px; color: var(--text-faint); margin-bottom: 6px; }
  .cart-bottom-row { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
  .cart-price { font-size: 14px; font-weight: 800; color: var(--accent-end); }
  .qty-stepper { display: flex; align-items: center; gap: 10px; background: var(--field-bg); border-radius: var(--r-pill); padding: 5px 10px; }
  .qty-btn { width: 20px; height: 20px; border-radius: 6px; background: var(--surface); display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--blue); font-size: 13px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  .qty-val { font-size: 12.5px; font-weight: 700; color: var(--text); min-width: 14px; text-align: center; }
  .remove-btn { color: var(--text-faint); flex-shrink: 0; padding: 2px; }
  .item-top-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }

  .cod-tag {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--success-bg); color: var(--success);
    font-size: 11px; font-weight: 700; padding: 6px 11px; border-radius: var(--r-sm);
    margin: 4px 0 14px;
  }

  .cart-summary {
    background: var(--surface); border-radius: var(--r-lg);
    padding: 16px; margin-top: 6px;
    box-shadow: 0 1px 4px rgba(20,30,50,.05);
  }
  .summary-row { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--text-dim); margin-bottom: 9px; }
  .summary-row.total {
    font-size: 16px; font-weight: 800; color: var(--text);
    border-top: 1px solid var(--border); padding-top: 12px; margin-top: 6px; margin-bottom: 0;
  }
  .summary-row.total span:last-child { color: var(--accent-end); }

  .cart-footer {
    padding: 14px 16px calc(14px + env(safe-area-inset-bottom));
    background: var(--surface); border-top: 1px solid var(--border); flex-shrink: 0;
  }
  .checkout-btn {
    background: var(--accent-grad); border-radius: var(--r-md);
    padding: 16px; text-align: center; color: #fff; font-weight: 800; font-size: 14.5px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .checkout-btn:disabled { opacity: .5; }

  .empty-cart {
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 40px 24px; text-align: center;
  }
  .empty-cart svg { width: 60px; height: 60px; color: var(--border); margin-bottom: 16px; }
  .empty-cart p { color: var(--text-dim); font-size: 14px; margin-bottom: 20px; line-height: 1.6; }
  .empty-cart .browse-btn {
    background: var(--blue); color: #fff; font-weight: 700; font-size: 13.5px;
    padding: 12px 26px; border-radius: var(--r-pill);
  }
</style>
</head>
<body>
<div class="app safe-top safe-bottom">

  <div class="cart-header">
    <button class="back-btn" onclick="window.location.href='/'">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16213A" stroke-width="2.5"><path d="M19 12H5M5 12l7-7M5 12l7 7"/></svg>
    </button>
    <h1>My Cart</h1>
    <span class="item-count" id="item-count"></span>
  </div>

  <div id="cart-body-wrap" style="display:flex;flex-direction:column;flex:1;overflow:hidden;min-height:0;">
    <div class="cart-body" id="cart-body">
      <!-- items injected here -->
    </div>

    <div class="cart-footer hidden" id="cart-footer">
      <button class="checkout-btn" id="checkout-btn" onclick="goToCheckout()">
        Checkout
        <span id="checkout-total"></span>
      </button>
    </div>
  </div>

  <div class="empty-cart hidden" id="empty-cart">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 002 1.6h9.7a2 2 0 002-1.6L23 6H6"/></svg>
    <p>Your cart is empty.<br/>Find something you'll love.</p>
    <button class="browse-btn" onclick="window.location.href='/'">Start Shopping</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script type="module">
import { getCart, updateQty, removeFromCart, getCartSubtotal, getCartTotal, DELIVERY_FEE } from "/js/cart.js";

function formatNaira(n) {
  return "₦" + Number(n).toLocaleString("en-NG");
}
function escHtml(s) {
  return String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
function toastMsg(msg, dur = 2000) {
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.classList.add("show");
  setTimeout(() => el.classList.remove("show"), dur);
}
window.toast = toastMsg;

function render() {
  const cart = getCart();
  const bodyWrap = document.getElementById("cart-body-wrap");
  const emptyState = document.getElementById("empty-cart");
  const body = document.getElementById("cart-body");
  const footer = document.getElementById("cart-footer");
  const itemCount = document.getElementById("item-count");

  if (!cart.length) {
    bodyWrap.classList.add("hidden");
    emptyState.classList.remove("hidden");
    itemCount.textContent = "";
    return;
  }

  bodyWrap.classList.remove("hidden");
  emptyState.classList.add("hidden");
  footer.classList.remove("hidden");

  const totalQty = cart.reduce((s, i) => s + i.qty, 0);
  itemCount.textContent = `${totalQty} item${totalQty !== 1 ? "s" : ""}`;

  body.innerHTML = cart.map(item => `
    <div class="cart-item">
      <div class="cart-thumb">
        ${item.imageUrl ? `<img src="${item.imageUrl}" alt="${escHtml(item.name)}"/>` : ""}
      </div>
      <div class="cart-info">
        <div class="item-top-row">
          <div class="cart-name">${escHtml(item.name)}</div>
          <button class="remove-btn" onclick="removeItem('${item.productId}')" aria-label="Remove">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6m4-6v6"/><path d="M9 6V4h6v2"/></svg>
          </button>
        </div>
        <div class="cart-seller">Sold by ${escHtml(item.sellerName || "Tradehub Seller")}</div>
        <div class="cart-bottom-row">
          <span class="cart-price">${formatNaira(item.price * item.qty)}</span>
          <div class="qty-stepper">
            <button class="qty-btn" onclick="changeQty('${item.productId}', -1)">−</button>
            <span class="qty-val">${item.qty}</span>
            <button class="qty-btn" onclick="changeQty('${item.productId}', 1)">+</button>
          </div>
        </div>
      </div>
    </div>
  `).join("");

  const subtotal = getCartSubtotal();
  const total = getCartTotal();
  document.getElementById("checkout-total").textContent = formatNaira(total);

  // Inject summary after the items
  const existingSummary = document.getElementById("cart-summary");
  if (existingSummary) existingSummary.remove();
  const summary = document.createElement("div");
  summary.id = "cart-summary";
  summary.innerHTML = `
    <div class="cod-tag">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      Cash on Delivery available
    </div>
    <div class="cart-summary">
      <div class="summary-row"><span>Subtotal</span><span>${formatNaira(subtotal)}</span></div>
      <div class="summary-row"><span>Delivery</span><span>${formatNaira(DELIVERY_FEE)}</span></div>
      <div class="summary-row total"><span>Total</span><span>${formatNaira(total)}</span></div>
    </div>
  `;
  body.appendChild(summary);
}

window.changeQty = function (productId, delta) {
  const cart = getCart();
  const item = cart.find(i => i.productId === productId);
  if (!item) return;
  updateQty(productId, item.qty + delta);
  render();
};

window.removeItem = function (productId) {
  removeFromCart(productId);
  toastMsg("Removed from cart");
  render();
};

window.goToCheckout = function () {
  window.location.href = "/checkout";
};

render();
</script>
</body>
</html>
