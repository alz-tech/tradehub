<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>Tradehub — Product</title>
<link rel="stylesheet" href="/css/style.css"/>
<style>
  .pd-header {
    position: sticky; top: 0; z-index: 10;
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px; background: transparent;
  }
  .pd-icon-btn {
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255,255,255,.92);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,.1);
  }
  .pd-icon-btn.liked svg { fill: var(--accent-end); stroke: var(--accent-end); }

  .pd-gallery {
    margin-top: -52px;
    aspect-ratio: 1/0.9;
    background: linear-gradient(160deg, #dde6f0, #c5d4e6);
    position: relative;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .pd-gallery img { width: 100%; height: 100%; object-fit: cover; }
  .pd-gallery-dots {
    position: absolute; bottom: 12px; left: 0; right: 0;
    display: flex; justify-content: center; gap: 5px;
  }
  .pd-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.6); }
  .pd-dot.active { background: #fff; width: 16px; border-radius: 4px; }

  .pd-body { flex: 1; padding: 18px 16px 100px; }

  .pd-price-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  .pd-price { font-size: 26px; font-weight: 900; color: var(--accent-end); }
  .pd-price-old { font-size: 14px; color: var(--text-faint); text-decoration: line-through; }
  .pd-discount-tag { background: var(--accent-bg-soft); color: var(--accent-end); font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 7px; }

  .pd-title { font-size: 16.5px; font-weight: 700; color: var(--text); line-height: 1.45; margin-bottom: 10px; }

  .pd-meta-row { display: flex; align-items: center; gap: 14px; font-size: 12.5px; color: var(--text-dim); margin-bottom: 18px; flex-wrap: wrap; }
  .pd-meta-row .meta-item { display: flex; align-items: center; gap: 5px; }

  .pd-divider { height: 1px; background: var(--border); margin: 18px 0; }

  .pd-seller-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: 13px 14px;
    display: flex; align-items: center; gap: 12px;
  }
  .pd-seller-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 800; font-size: 15px; flex-shrink: 0;
  }
  .pd-seller-info { flex: 1; }
  .pd-seller-name { font-size: 13.5px; font-weight: 700; color: var(--text); margin-bottom: 2px; }
  .pd-seller-meta { font-size: 11px; color: var(--text-dim); display: flex; align-items: center; gap: 4px; }

  .pd-section-label { font-size: 13.5px; font-weight: 800; color: var(--text); margin-bottom: 8px; }
  .pd-desc { font-size: 13px; color: var(--text-dim); line-height: 1.7; }

  .qty-section { display: flex; align-items: center; justify-content: space-between; margin: 18px 0; }
  .qty-stepper { display: flex; align-items: center; gap: 14px; background: var(--field-bg); border-radius: var(--r-pill); padding: 8px 14px; }
  .qty-btn { width: 24px; height: 24px; border-radius: 7px; background: var(--surface); display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--blue); box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  .qty-btn:active { transform: scale(.95); }
  .qty-val { font-size: 14px; font-weight: 700; color: var(--text); min-width: 16px; text-align: center; }
  .stock-note { font-size: 11.5px; color: var(--success); display: flex; align-items: center; gap: 5px; }

  .pd-footer {
    position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
    width: 100%; max-width: 480px;
    display: flex; gap: 10px; padding: 12px 16px calc(14px + env(safe-area-inset-bottom));
    background: var(--surface); border-top: 1px solid var(--border);
  }
  .pd-cart-btn {
    width: 50px; height: 50px; border-radius: var(--r-md);
    background: var(--field-bg);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; position: relative;
  }
  .pd-cart-btn .cart-count {
    position: absolute; top: -4px; right: -4px;
    background: var(--accent-end); color: #fff;
    font-size: 9px; font-weight: 800; width: 16px; height: 16px;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
  }
  .pd-buy-btn {
    flex: 1; background: var(--accent-grad); border-radius: var(--r-md);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 800; font-size: 14.5px;
    gap: 8px;
  }
  .pd-buy-btn:disabled { opacity: .6; }

  .loading-wrap { flex: 1; display: flex; align-items: center; justify-content: center; }
  .spinner { width: 28px; height: 28px; border: 3px solid var(--border); border-top-color: var(--blue); border-radius: 50%; animation: spin .7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Reviews ── */
  .rv-list-stars { display: flex; gap: 1px; }
  .rv-item { padding: 12px 0; border-bottom: 1px solid var(--border); }
  .rv-item:last-child { border-bottom: none; }
  .rv-item-top { display: flex; align-items: center; gap: 8px; margin-bottom: 5px; }
  .rv-item-name { font-size: 12.5px; font-weight: 700; color: var(--text); }
  .rv-item-date { font-size: 10.5px; color: var(--text-faint); margin-left: auto; }
  .rv-item-remark { font-size: 12.5px; color: var(--text-dim); line-height: 1.6; }
  .rv-empty-note { font-size: 12px; color: var(--text-faint); padding: 6px 0; }
</style>
</head>
<body>
<div class="app">

  <div id="loading-state" class="loading-wrap"><div class="spinner"></div></div>

  <div id="product-content" class="hidden app-scroll" style="display:flex;flex-direction:column;">
    <div class="pd-header">
      <button class="pd-icon-btn" onclick="history.back()">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#16213A" stroke-width="2.5"><path d="M19 12H5M5 12l7-7M5 12l7 7"/></svg>
      </button>
      <button class="pd-icon-btn" id="like-btn" onclick="toggleLike()">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#16213A" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
      </button>
    </div>

    <div class="pd-gallery" id="pd-gallery">
      <div class="pd-gallery-dots"><div class="pd-dot active"></div></div>
    </div>

    <div class="pd-body">
      <div id="pd-status-banner" class="hidden" style="border-radius:var(--r-md);padding:10px 14px;margin-bottom:14px;font-size:12.5px;font-weight:700;"></div>

      <div class="pd-price-row">
        <span class="pd-price" id="pd-price"></span>
        <span class="pd-price-old hidden" id="pd-price-old"></span>
        <span class="pd-discount-tag hidden" id="pd-discount-tag"></span>
      </div>

      <div class="pd-title" id="pd-title"></div>

      <div class="pd-meta-row">
        <div class="meta-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="#FFB23E"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
          <span id="pd-rating"></span>
        </div>
        <div class="meta-item" id="pd-sold"></div>
        <div class="meta-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span id="pd-location"></span>
        </div>
      </div>

      <div class="qty-section">
        <div class="pd-section-label" style="margin:0;">Quantity</div>
        <div class="qty-stepper">
          <button class="qty-btn" onclick="changeQty(-1)">−</button>
          <span class="qty-val" id="qty-val">1</span>
          <button class="qty-btn" onclick="changeQty(1)">+</button>
        </div>
      </div>

      <div class="pd-seller-card">
        <div class="pd-seller-avatar" id="pd-seller-avatar"></div>
        <div class="pd-seller-info">
          <div class="pd-seller-name" id="pd-seller-name"></div>
          <div class="pd-seller-meta" id="pd-seller-meta"></div>
        </div>
      </div>

      <a id="pd-seller-phone-row" class="hidden" href="#" style="display:flex;align-items:center;gap:10px;background:var(--success-bg);border-radius:var(--r-md);padding:12px 14px;margin-top:10px;text-decoration:none;">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#1FAE6E" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        <div>
          <div style="font-size:12px;font-weight:700;color:#1FAE6E;">Call Seller</div>
          <div id="pd-seller-phone-num" style="font-size:11.5px;color:var(--text-dim);"></div>
        </div>
      </a>

      <div class="pd-divider"></div>

      <div class="pd-section-label">Description</div>
      <div class="pd-desc" id="pd-desc"></div>

      <div class="pd-divider"></div>

      <div class="pd-section-label">Reviews</div>
      <div id="pd-reviews" style="padding-bottom:76px;"><div class="rv-empty-note">Loading reviews…</div></div>

      <div class="pd-divider"></div>

      <div class="stock-note">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Cash on Delivery available
      </div>
    </div>

    <div class="pd-footer">
      <button class="pd-cart-btn" onclick="addToCart()">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#3DA9FC" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 002 1.6h9.7a2 2 0 002-1.6L23 6H6"/></svg>
        <span class="cart-count hidden" id="cart-badge" onclick="event.stopPropagation();window.location.href='/cart'">0</span>
      </button>
      <button class="pd-buy-btn" id="buy-now-btn" onclick="buyNow()">
        Buy Now
      </button>
    </div>
  </div>

  <div id="not-found-state" class="hidden loading-wrap" style="flex-direction:column;gap:12px;padding:0 32px;text-align:center;">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C5D4E6" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
    <p style="color:var(--text-dim);font-size:14px;">Product not found.</p>
    <p id="not-found-reason" class="hidden" style="color:var(--text-faint);font-size:11.5px;line-height:1.5;word-break:break-word;"></p>
    <button class="btn-text" onclick="window.location.href='/'" style="color:var(--blue);font-weight:700;font-size:14px;">Back to Tradehub</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script type="module">
import { getProduct, addToWishlist, removeFromWishlist, isInWishlist, getProductReviews } from "/js/products.js";
import { getCart, addToCart as addToCartStore, getCartCount } from "/js/cart.js";
import { getCurrentUser } from "/js/auth.js";

const params    = new URLSearchParams(location.search);
const productId = params.get("id");
let product     = null;
let qty         = 1;
let liked       = false;
let currentUserId = null;

const SELLER_COLORS = ["#3DA9FC","#FF5C8A","#FF7A59","#1FAE6E","#7C3AED","#FFB23E"];

function colorForName(name) {
  let hash = 0;
  for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
  return SELLER_COLORS[Math.abs(hash) % SELLER_COLORS.length];
}

function formatNaira(n) {
  return "₦" + Number(n).toLocaleString("en-NG");
}

function escHtml(s) {
  return String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

function toastMsg(msg, dur = 2200) {
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.classList.add("show");
  setTimeout(() => el.classList.remove("show"), dur);
}
window.toast = toastMsg;

async function init() {
  if (!productId) { showNotFound("No product ID was given in the link."); return; }
  try {
    product = await getProduct(productId);
    if (!product) { showNotFound("This listing doesn't exist or may have been removed."); return; }
    renderProduct();

    const user = await getCurrentUser();
    if (user) {
      currentUserId = user.id;
      liked = await isInWishlist(user.id, productId);
      document.getElementById("like-btn").classList.toggle("liked", liked);
    }

    loadReviews();
  } catch (e) {
    console.error(e);
    showNotFound(e.message || "Something went wrong loading this listing.");
  }
}

function showNotFound(reason) {
  document.getElementById("loading-state").classList.add("hidden");
  document.getElementById("not-found-state").classList.remove("hidden");
  const reasonEl = document.getElementById("not-found-reason");
  if (reason) {
    reasonEl.textContent = reason;
    reasonEl.classList.remove("hidden");
  }
}

function renderProduct() {
  document.getElementById("loading-state").classList.add("hidden");
  document.getElementById("product-content").classList.remove("hidden");

  document.title = `${product.name} — Tradehub`;

  // Status banner — only shows for non-approved listings (visible to the
  // seller themselves or an admin checking it; approved items show nothing)
  if (product.status && product.status !== "approved") {
    const banner = document.getElementById("pd-status-banner");
    banner.classList.remove("hidden");
    const ICON_CLOCK = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:5px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
    const ICON_X = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:5px;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
    if (product.status === "pending") {
      banner.style.background = "#FFF3E0";
      banner.style.color = "#C17A00";
      banner.innerHTML = ICON_CLOCK + "This listing is awaiting admin review and isn't visible to buyers yet.";
    } else if (product.status === "rejected") {
      banner.style.background = "#FFE5EC";
      banner.style.color = "#E0245E";
      banner.innerHTML = ICON_X + `This listing was rejected.${product.rejectionReason ? " Reason: " + escHtml(product.rejectionReason) : ""}`;
    }
  }

  // Gallery
  const gallery = document.getElementById("pd-gallery");
  if (product.imageUrl) {
    gallery.innerHTML = `<img src="${product.imageUrl}" alt="${escHtml(product.name)}"/><div class="pd-gallery-dots"><div class="pd-dot active"></div></div>`;
  }

  // Price
  document.getElementById("pd-price").textContent = formatNaira(product.price);
  if (product.oldPrice) {
    const oldEl = document.getElementById("pd-price-old");
    oldEl.textContent = formatNaira(product.oldPrice);
    oldEl.classList.remove("hidden");
    const discount = Math.round((1 - product.price / product.oldPrice) * 100);
    const tagEl = document.getElementById("pd-discount-tag");
    tagEl.textContent = `-${discount}%`;
    tagEl.classList.remove("hidden");
  }

  document.getElementById("pd-title").textContent = product.name;
  document.getElementById("pd-rating").textContent = `${product.rating?.toFixed(1) || "New"} (${product.reviewCount || 0} reviews)`;
  document.getElementById("pd-sold").textContent = `${product.sold || 0} sold`;
  document.getElementById("pd-location").textContent = product.sellerLocation || "Nigeria";
  document.getElementById("pd-desc").textContent = product.description || "No description provided.";

  // Seller
  const sellerColor = colorForName(product.sellerName || "Seller");
  const avatarEl = document.getElementById("pd-seller-avatar");
  avatarEl.style.background = sellerColor;
  avatarEl.textContent = (product.sellerName || "S").split(" ").map(w => w[0]).join("").slice(0, 2).toUpperCase();
  document.getElementById("pd-seller-name").textContent = product.sellerName || "Unknown Seller";
  document.getElementById("pd-seller-meta").innerHTML = `
    <svg width="11" height="11" viewBox="0 0 24 24" fill="#FFB23E" style="vertical-align:-1px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
    Seller · ${escHtml(product.sellerLocation || "Nigeria")}
  `;

  // Seller phone — shown if the seller provided one when they signed up
  if (product.sellerPhone) {
    const phoneRow = document.getElementById("pd-seller-phone-row");
    phoneRow.classList.remove("hidden");
    phoneRow.href = `tel:${product.sellerPhone}`;
    document.getElementById("pd-seller-phone-num").textContent = product.sellerPhone;
  }

  updateCartBadgeUI();
}

// ── Reviews (buyer remarks + star ratings) ──────────────
function starsHtml(count) {
  let out = '<div class="rv-list-stars">';
  for (let i = 1; i <= 5; i++) {
    out += `<svg width="11" height="11" viewBox="0 0 24 24" fill="${i <= count ? '#FFB23E' : 'none'}" stroke="#FFB23E" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>`;
  }
  return out + "</div>";
}

function formatReviewDate(ts) {
  if (!ts) return "";
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString("en-NG", { day: "numeric", month: "short", year: "numeric" });
}

async function loadReviews() {
  const wrap = document.getElementById("pd-reviews");
  try {
    const reviews = await getProductReviews(productId);
    if (!reviews.length) {
      wrap.innerHTML = '<div class="rv-empty-note">No reviews yet — be the first to rate this item after delivery.</div>';
      return;
    }
    wrap.innerHTML = reviews.map(r => `
      <div class="rv-item">
        <div class="rv-item-top">
          ${starsHtml(r.stars)}
          <span class="rv-item-name">${escHtml(r.buyerName || "Anonymous")}</span>
          <span class="rv-item-date">${formatReviewDate(r.createdAt)}</span>
        </div>
        ${r.remark ? `<div class="rv-item-remark">${escHtml(r.remark)}</div>` : ""}
      </div>
    `).join("");
  } catch (e) {
    console.error(e);
    wrap.innerHTML = '<div class="rv-empty-note">Couldn\'t load reviews.</div>';
  }
}

// ── Quantity stepper ───────────────────────────────────
window.changeQty = function (delta) {
  qty = Math.max(1, qty + delta);
  document.getElementById("qty-val").textContent = qty;
};

// ── Like / wishlist toggle ──────────────────────────────
window.toggleLike = async function () {
  if (!currentUserId) {
    const user = await getCurrentUser();
    if (!user) {
      toastMsg("Sign in to save items to your wishlist");
      setTimeout(() => window.location.href = "/auth", 1200);
      return;
    }
    currentUserId = user.id;
  }

  const btn = document.getElementById("like-btn");
  try {
    if (liked) {
      await removeFromWishlist(currentUserId, productId);
      liked = false;
      toastMsg("Removed from wishlist");
    } else {
      await addToWishlist(currentUserId, productId);
      liked = true;
      toastMsg("Added to wishlist");
    }
    btn.classList.toggle("liked", liked);
  } catch (e) {
    toastMsg("Couldn't update wishlist: " + e.message);
  }
};

// ── Cart (now backed by shared js/cart.js module) ──────
function updateCartBadgeUI() {
  const count = getCartCount();
  const badge = document.getElementById("cart-badge");
  if (count > 0) {
    badge.textContent = count > 9 ? "9+" : count;
    badge.classList.remove("hidden");
  } else {
    badge.classList.add("hidden");
  }
}

window.addToCart = function () {
  addToCartStore({
    productId,
    name: product.name,
    price: product.price,
    imageUrl: product.imageUrl,
    sellerName: product.sellerName,
    sellerId: product.sellerId || null,
    sellerPhone: product.sellerPhone || null
  }, qty);
  updateCartBadgeUI();
  toastMsg(`Added ${qty} to cart`);
};

window.buyNow = function () {
  window.addToCart();
  window.location.href = "/cart";
};

init();
</script>
</body>
</html>
