<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>Tradehub — Admin</title>
<link rel="stylesheet" href="/css/style.css"/>
<style>
  .ad-header {
    padding: 16px; background: #16213A; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 12px; flex-shrink: 0;
  }
  .ad-header h1 { font-size: 16.5px; font-weight: 800; color: #fff; flex: 1; }
  .ad-badge { background: var(--blue); color: #fff; font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: var(--r-pill); }

  .ad-tabs { display: flex; background: var(--surface); border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .ad-tab {
    flex: 1; text-align: center; padding: 10px 4px 11px; font-size: 11px; font-weight: 700;
    color: var(--text-faint); position: relative; display: flex; flex-direction: column; align-items: center; gap: 3px;
  }
  .ad-tab svg { width: 18px; height: 18px; }
  .ad-tab.active { color: var(--blue); }
  .ad-tab.active::after { content: ''; position: absolute; bottom: 0; left: 20%; right: 20%; height: 2px; background: var(--blue); }
  .ad-tab .count-dot {
    position: absolute; top: 4px; left: 50%; margin-left: 5px;
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 15px; height: 15px; border-radius: 8px; background: var(--danger); color: #fff;
    font-size: 8.5px; font-weight: 800; padding: 0 3px;
  }

  /* ── Sub-filter pills (used inside the Products tab for status) ── */
  .ad-subfilter { display: flex; gap: 8px; padding: 2px 0 14px; overflow-x: auto; }
  .ad-subfilter-pill {
    flex-shrink: 0; padding: 7px 14px; border-radius: var(--r-pill); font-size: 12px; font-weight: 700;
    background: var(--field-bg); color: var(--text-dim); white-space: nowrap; display: flex; align-items: center; gap: 5px;
  }
  .ad-subfilter-pill.active { background: var(--blue); color: #fff; }
  .ad-subfilter-pill .count-dot {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 15px; height: 15px; border-radius: 8px; background: var(--danger); color: #fff;
    font-size: 8.5px; font-weight: 800; padding: 0 3px;
  }
  .ad-subfilter-pill.active .count-dot { background: rgba(255,255,255,.35); }

  /* ── Site settings tab ── */
  .settings-item { background: var(--surface); border-radius: var(--r-lg); padding: 16px; margin-bottom: 12px; box-shadow: 0 1px 4px rgba(20,30,50,.05); }
  .settings-item h3 { font-size: 13px; font-weight: 800; color: var(--text); margin-bottom: 5px; display: flex; align-items: center; gap: 7px; }
  .settings-item p { font-size: 12px; color: var(--text-dim); line-height: 1.6; margin-bottom: 12px; }

  /* ── Orders tab ── */
  .ord-card { background: var(--surface); border-radius: var(--r-lg); padding: 14px; margin-bottom: 10px; box-shadow: 0 1px 4px rgba(20,30,50,.05); }
  .ord-top-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
  .ord-id { font-size: 12.5px; font-weight: 700; color: var(--text); }
  .ord-date { font-size: 10.5px; color: var(--text-faint); margin-top: 2px; }
  .ord-status { font-size: 10px; font-weight: 800; padding: 4px 10px; border-radius: var(--r-pill); text-transform: capitalize; }
  .ord-status.pending { background: #FFF3E0; color: #C17A00; }
  .ord-status.delivered { background: var(--success-bg); color: var(--success); }
  .ord-status.cancelled { background: #FFE5EC; color: var(--danger); }
  .ord-buyer-box { background: var(--field-bg); border-radius: var(--r-md); padding: 10px 12px; margin-bottom: 10px; font-size: 11.5px; color: var(--text-dim); }
  .ord-buyer-box strong { color: var(--text); }
  .ord-item-row { font-size: 12px; color: var(--text-dim); padding: 3px 0; }
  .ord-item-row strong { color: var(--text); }
  .ord-divider { height: 1px; background: var(--border); margin: 10px 0; }
  .ord-total-row { display: flex; justify-content: space-between; font-size: 13px; font-weight: 800; color: var(--text); }
  .ord-total-row span:last-child { color: var(--accent-end); }
  .ord-sellers { font-size: 10.5px; color: var(--text-faint); margin-top: 4px; }

  .ad-body { flex: 1; padding: 14px 16px 20px; overflow-y: auto; }

  .ad-card { background: var(--surface); border-radius: var(--r-lg); padding: 14px; margin-bottom: 12px; box-shadow: 0 1px 4px rgba(20,30,50,.06); }
  .ad-card-top { display: flex; gap: 12px; margin-bottom: 12px; }
  .ad-thumb { width: 64px; height: 64px; border-radius: var(--r-sm); background: linear-gradient(160deg,#dde6f0,#c5d4e6); flex-shrink: 0; overflow: hidden; }
  .ad-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .ad-info { flex: 1; min-width: 0; }
  .ad-name { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 3px; line-height: 1.3; }
  .ad-price { font-size: 14px; font-weight: 800; color: var(--accent-end); margin-bottom: 3px; }
  .ad-cat { font-size: 10.5px; color: var(--text-faint); text-transform: capitalize; }

  .ad-seller-row { background: var(--field-bg); border-radius: var(--r-sm); padding: 9px 11px; font-size: 11.5px; color: var(--text-dim); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
  .ad-desc { font-size: 12px; color: var(--text-dim); line-height: 1.5; margin-bottom: 12px; }

  .ad-actions { display: flex; gap: 8px; }
  .ad-btn { flex: 1; padding: 11px; border-radius: var(--r-sm); text-align: center; font-size: 12.5px; font-weight: 800; display: flex; align-items: center; justify-content: center; gap: 6px; }
  .ad-btn.approve { background: var(--success-bg); color: var(--success); }
  .ad-btn.reject { background: #FFE5EC; color: var(--danger); }
  .ad-btn.view { background: var(--field-bg); color: var(--text-dim); flex: 0 0 44px; }

  .ad-status-tag { font-size: 9.5px; font-weight: 800; padding: 3px 8px; border-radius: var(--r-pill); text-transform: uppercase; letter-spacing: .3px; }
  .ad-status-tag.approved { background: var(--success-bg); color: var(--success); }
  .ad-status-tag.pending { background: #FFF3E0; color: #C17A00; }
  .ad-status-tag.rejected { background: #FFE5EC; color: var(--danger); }

  .ad-cleanup-card { background: #FFF3E0; border: 1px solid #FFD699; border-radius: var(--r-lg); padding: 16px; margin-bottom: 16px; }
  .ad-cleanup-card h3 { font-size: 13px; font-weight: 800; color: #8A5800; margin-bottom: 6px; }
  .ad-cleanup-card p { font-size: 12px; color: #8A5800; line-height: 1.6; margin-bottom: 12px; }
  .ad-cleanup-btn { background: #C17A00; color: #fff; font-size: 12.5px; font-weight: 700; padding: 10px 18px; border-radius: var(--r-sm); }

  .empty-state { text-align: center; padding: 50px 24px; }
  .empty-state svg { width: 48px; height: 48px; color: var(--border); margin-bottom: 14px; }
  .empty-state p { color: var(--text-dim); font-size: 13.5px; line-height: 1.6; }

  .denied-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 24px; text-align: center; }
  .denied-wrap svg { width: 52px; height: 52px; color: var(--danger); margin-bottom: 16px; }
  .denied-wrap p { color: var(--text-dim); font-size: 14px; line-height: 1.6; }

  .spinner-wrap { flex: 1; display: flex; align-items: center; justify-content: center; }
  .spinner { width: 28px; height: 28px; border: 3px solid var(--border); border-top-color: var(--blue); border-radius: 50%; animation: spin .7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Subscriptions tab ── */
  .sub-card { background: var(--surface); border-radius: var(--r-lg); padding: 14px; margin-bottom: 10px; box-shadow: 0 1px 4px rgba(20,30,50,.05); }
  .sub-top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .sub-name { font-size: 13px; font-weight: 700; color: var(--text); }
  .sub-pill { font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: var(--r-pill); text-transform: uppercase; letter-spacing: .3px; }
  .sub-pill.trial { background: var(--accent-bg-soft); color: var(--accent-end); }
  .sub-pill.active { background: var(--success-bg); color: var(--success); }
  .sub-pill.expired { background: #FFE5EC; color: var(--danger); }
  .sub-pill.none { background: var(--field-bg); color: var(--text-faint); }
  .sub-detail { font-size: 11.5px; color: var(--text-dim); margin-bottom: 10px; }
  .sub-actions { display: flex; gap: 6px; flex-wrap: wrap; }
  .sub-btn { font-size: 11px; font-weight: 700; padding: 7px 10px; border-radius: var(--r-sm); background: var(--field-bg); color: var(--text-dim); }
  .sub-btn.primary { background: #E0F0FF; color: var(--blue); }
  .sub-btn.danger { background: #FFE5EC; color: var(--danger); }

  /* ── Users tab ── */
  .usr-card { background: var(--surface); border-radius: var(--r-lg); padding: 14px; margin-bottom: 10px; box-shadow: 0 1px 4px rgba(20,30,50,.05); }
  .usr-top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; gap: 8px; }
  .usr-name { font-size: 13px; font-weight: 700; color: var(--text); }
  .usr-handle { color: var(--text-faint); font-weight: 500; }
  .usr-badges { display: flex; gap: 6px; flex-shrink: 0; }
  .usr-pill { font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: var(--r-pill); text-transform: uppercase; letter-spacing: .3px; white-space: nowrap; }
  .usr-pill.admin { background: var(--accent-bg-soft); color: var(--accent-end); }
  .usr-pill.invincible { background: #FFF3E0; color: #C17A00; display: inline-flex; align-items: center; gap: 3px; }
  .usr-detail { font-size: 11.5px; color: var(--text-dim); margin-bottom: 10px; }
  .usr-actions { display: flex; gap: 6px; flex-wrap: wrap; }
  .usr-btn { font-size: 11px; font-weight: 700; padding: 7px 10px; border-radius: var(--r-sm); background: var(--field-bg); color: var(--text-dim); }
  .usr-btn.primary { background: #E0F0FF; color: var(--blue); }
  .usr-btn.danger { background: #FFE5EC; color: var(--danger); }
  .usr-btn:disabled, .usr-btn.disabled { opacity: .45; }
</style>
</head>
<body>
<div class="app safe-top safe-bottom">

  <div id="loading" class="spinner-wrap"><div class="spinner"></div></div>

  <div id="denied-view" class="hidden denied-wrap">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
    <p>This page isn't available.</p>
  </div>

  <div id="admin-view" class="hidden" style="display:flex;flex-direction:column;flex:1;min-height:0;">
    <div class="ad-header">
      <button onclick="window.location.href='/'" style="display:flex;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><path d="M19 12H5M5 12l7-7M5 12l7 7"/></svg>
      </button>
      <h1>Admin</h1>
      <span class="ad-badge">Tradehub</span>
    </div>

    <div class="ad-tabs">
      <div class="ad-tab active" data-tab="users" onclick="switchTab('users')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        Users
      </div>
      <div class="ad-tab" data-tab="products" onclick="switchTab('products')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        Products <span class="count-dot hidden" id="pending-count">0</span>
      </div>
      <div class="ad-tab" data-tab="subscription" onclick="switchTab('subscription')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        Subscription
      </div>
      <div class="ad-tab" data-tab="settings" onclick="switchTab('settings')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
        Site settings
      </div>
      <div class="ad-tab" data-tab="orders" onclick="switchTab('orders')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7L12 3 4 7m16 0v10l-8 4m8-14l-8 4m0 10l-8-4V7m8 14V11M4 7l8 4"/></svg>
        Orders
      </div>
    </div>

    <div class="ad-body" id="ad-body">
      <!-- content injected per tab -->
    </div>
  </div>
</div>

<div id="reject-modal" class="hidden modal-overlay" onclick="if(event.target===this) closeRejectModal()">
  <div class="modal-box">
    <h3>Reject this listing</h3>
    <textarea id="reject-reason" placeholder="Why is this being rejected? (shown to the seller)"></textarea>
    <div class="modal-btns">
      <button class="modal-btn cancel" onclick="closeRejectModal()">Cancel</button>
      <button class="modal-btn confirm" onclick="confirmReject()">Reject Listing</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script type="module">
import { getSessionInfo, getAllSellers } from "/js/auth.js";
import { confirmDialog } from "/js/ui.js";
import {
  getPendingProducts, getAllProductsForAdmin, approveProduct, rejectProduct, deleteProduct, getAllOrdersForAdmin
} from "/js/products.js";

import {
  adminStartTrial, adminGrantPaidDays, adminEndAccess
} from "/js/subscriptions.js";

import {
  getAllUsers, promoteUser, demoteUser, deleteUser
} from "/js/users.js";

// ════════════════════════════════════════════════════
// ADMIN ACCESS: this is now enforced server-side. The /admin route
// itself (routes/admin/pages.js) runs the requireAdmin middleware
// before this page is ever sent to the browser, and every admin API
// call below (/api/admin/*, /api/subscriptions/admin/*) re-checks
// req.isAdmin server-side too — so unlike the old client-side-only
// allowlist, a non-admin genuinely cannot reach this data no matter
// what they do in devtools. The check below is just a friendly UI
// state (denied-view) for the rare case this page is reached without
// admin rights; the real gate already happened before this file loaded.
// ════════════════════════════════════════════════════

let currentTab = "users";
let productSubFilter = "pending"; // sub-filter inside the Products tab
let rejectTargetId = null;
let cachedAll = null; // all products, fetched once for approved/rejected sub-filters

function toastMsg(msg, dur = 2500) {
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.classList.add("show");
  setTimeout(() => el.classList.remove("show"), dur);
}
function formatNaira(n) { return "₦" + Number(n).toLocaleString("en-NG"); }
function escHtml(s) { return String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

async function init() {
  const { user, isAdmin } = await getSessionInfo();
  if (!user || !isAdmin) {
    document.getElementById("loading").classList.add("hidden");
    document.getElementById("denied-view").classList.remove("hidden");
    document.getElementById("denied-view").style.display = "flex";
    return;
  }
  currentUsername = user.username;

  document.getElementById("loading").classList.add("hidden");
  document.getElementById("admin-view").classList.remove("hidden");
  await loadTab("users");
}

window.switchTab = async function (tab) {
  currentTab = tab;
  document.querySelectorAll(".ad-tab").forEach(t => t.classList.toggle("active", t.dataset.tab === tab));
  await loadTab(tab);
};

async function loadTab(tab) {
  const body = document.getElementById("ad-body");
  body.innerHTML = '<div class="spinner-wrap" style="padding:40px 0;"><div class="spinner"></div></div>';

  try {
    if (tab === "settings") {
      renderSettingsTab();
      return;
    }
    if (tab === "subscription") {
      await renderSubsTab();
      return;
    }
    if (tab === "users") {
      await renderUsersTab();
      return;
    }
    if (tab === "orders") {
      await renderOrdersTab();
      return;
    }
    if (tab === "products") {
      await renderProductsTab();
      return;
    }
  } catch (e) {
    console.error(e);
    body.innerHTML = `<div class="empty-state"><p>Something went wrong.<br/><span style="font-size:11px;color:var(--text-faint);word-break:break-word;">${escHtml(e.message)}</span></p></div>`;
  }
}

// ── Products tab: Pending/Approved/Rejected moderation ─
// Same three states as before, now nested as a sub-filter inside one
// top-level "Products" tab instead of three separate top-level tabs.
window.setProductFilter = async function (status) {
  productSubFilter = status;
  await renderProductsTab();
};

async function renderProductsTab() {
  const body = document.getElementById("ad-body");
  try {
  let products;
  let pendingCountForBadge = null;
  if (productSubFilter === "pending") {
    products = await getPendingProducts();
    pendingCountForBadge = products.length;
  } else {
    if (!cachedAll) cachedAll = await getAllProductsForAdmin();
    products = cachedAll.filter(p => p.status === productSubFilter);
    // Still need the pending count for the sub-filter pill's badge even
    // when viewing a different sub-filter, and for the top-level tab dot.
    if (cachedAll) pendingCountForBadge = cachedAll.filter(p => p.status === "pending").length;
  }

  // Keep the top-level Products tab's badge in sync no matter which
  // sub-filter is currently open.
  const tabCountEl = document.getElementById("pending-count");
  if (pendingCountForBadge !== null && pendingCountForBadge > 0) {
    tabCountEl.textContent = pendingCountForBadge;
    tabCountEl.classList.remove("hidden");
  } else {
    tabCountEl.classList.add("hidden");
  }

  const subfilterHtml = `
    <div class="ad-subfilter">
      <div class="ad-subfilter-pill ${productSubFilter === 'pending' ? 'active' : ''}" onclick="setProductFilter('pending')">
        Pending ${pendingCountForBadge ? `<span class="count-dot">${pendingCountForBadge}</span>` : ''}
      </div>
      <div class="ad-subfilter-pill ${productSubFilter === 'approved' ? 'active' : ''}" onclick="setProductFilter('approved')">Approved</div>
      <div class="ad-subfilter-pill ${productSubFilter === 'rejected' ? 'active' : ''}" onclick="setProductFilter('rejected')">Rejected</div>
    </div>
  `;

  if (!products.length) {
    body.innerHTML = subfilterHtml + `
      <div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
        <p>No ${productSubFilter} listings right now.</p>
      </div>
    `;
    return;
  }

  body.innerHTML = subfilterHtml + products.map(p => `
      <div class="ad-card">
        <div class="ad-card-top">
          <div class="ad-thumb">${p.imageUrl ? `<img src="${p.imageUrl}"/>` : ""}</div>
          <div class="ad-info">
            <div class="ad-name">${escHtml(p.name)}</div>
            <div class="ad-price">${formatNaira(p.price)}</div>
            <div class="ad-cat">${escHtml(p.category || "uncategorized")}</div>
          </div>
          <span class="ad-status-tag ${p.status}">${p.status}</span>
        </div>
        <div class="ad-seller-row">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          ${escHtml(p.sellerName || "Unknown")} · ${escHtml(p.sellerLocation || "—")} ${p.sellerPhone ? "· " + escHtml(p.sellerPhone) : ""}
        </div>
        <div class="ad-desc">${escHtml(p.description || "No description.")}</div>
        ${p.status === 'rejected' && p.rejectionReason ? `<div class="ad-desc" style="color:var(--danger);"><strong>Rejection reason:</strong> ${escHtml(p.rejectionReason)}</div>` : ''}
        <div class="ad-actions">
          ${p.status === 'pending' ? `
            <button class="ad-btn approve" onclick="handleApprove('${p.id}')">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Approve
            </button>
            <button class="ad-btn reject" onclick="openRejectModal('${p.id}')">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              Reject
            </button>
          ` : p.status === 'rejected' ? `
            <button class="ad-btn approve" onclick="handleApprove('${p.id}')">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Approve Anyway
            </button>
          ` : `
            <button class="ad-btn reject" onclick="openRejectModal('${p.id}')">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              Take Down
            </button>
          `}
          <a class="ad-btn view" href="/product/${p.id}" target="_blank">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </a>
        </div>
      </div>
    `).join("");
  } catch (e) {
    console.error(e);
    body.innerHTML = `<div class="empty-state"><p>Couldn't load listings.<br/><span style="font-size:11px;color:var(--text-faint);word-break:break-word;">${escHtml(e.message)}</span></p></div>`;
  }
}

window.handleApprove = async function (productId) {
  try {
    await approveProduct(productId);
    toastMsg("Listing approved");
    cachedAll = null; // invalidate cache so approved/rejected tabs refresh correctly
    await loadTab(currentTab);
  } catch (e) {
    toastMsg("Couldn't approve: " + e.message);
  }
};

window.openRejectModal = function (productId) {
  rejectTargetId = productId;
  document.getElementById("reject-reason").value = "";
  document.getElementById("reject-modal").classList.remove("hidden");
};

window.closeRejectModal = function () {
  document.getElementById("reject-modal").classList.add("hidden");
  rejectTargetId = null;
};

window.confirmReject = async function () {
  if (!rejectTargetId) return;
  const reason = document.getElementById("reject-reason").value.trim();
  try {
    await rejectProduct(rejectTargetId, reason);
    toastMsg("Listing rejected");
    closeRejectModal();
    cachedAll = null;
    await loadTab(currentTab);
  } catch (e) {
    toastMsg("Couldn't reject: " + e.message);
  }
};

// ── Orders tab: every order platform-wide ──────────────
// Unlike /sales (seller-scoped, one seller's slice of each order) or
// /orders (buyer-scoped, one buyer's own history), this shows every
// order across Tradehub, exactly as placed — including items from
// multiple sellers in one order where that applies.
function formatOrderDate(ts) {
  if (!ts) return "";
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString("en-NG", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" });
}

async function renderOrdersTab() {
  const body = document.getElementById("ad-body");
  try {
    const orders = await getAllOrdersForAdmin();

    if (!orders.length) {
      body.innerHTML = `
        <div class="empty-state">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 7L12 3 4 7m16 0v10l-8 4m8-14l-8 4m0 10l-8-4V7m8 14V11M4 7l8 4"/></svg>
          <p>No orders placed yet.</p>
        </div>
      `;
      return;
    }

    body.innerHTML = orders.map(order => `
      <div class="ord-card">
        <div class="ord-top-row">
          <div>
            <div class="ord-id">Order #${String(order.id).padStart(6, "0")}</div>
            <div class="ord-date">${formatOrderDate(order.createdAt)}</div>
          </div>
          <span class="ord-status ${order.status || 'pending'}">${order.status || 'pending'}</span>
        </div>

        <div class="ord-buyer-box">
          <strong>${escHtml(order.buyerName)}</strong> · ${escHtml(order.buyerPhone || "—")}<br/>
          ${escHtml(order.deliveryAddress || "No address given")}
          ${order.remark ? `<br/><em>"${escHtml(order.remark)}"</em>` : ''}
        </div>

        ${(order.items || []).map(item => `
          <div class="ord-item-row"><strong>${escHtml(item.name)}</strong>&nbsp;×${item.qty} — ${formatNaira(item.price * item.qty)}</div>
        `).join("")}

        <div class="ord-sellers">Seller${(order.sellerIds || []).length !== 1 ? 's' : ''}: ${(order.sellerIds || []).map(s => "@" + escHtml(s)).join(", ") || "—"}</div>

        <div class="ord-divider"></div>
        <div class="ord-total-row"><span>Total (incl. ${formatNaira(order.deliveryFee)} delivery)</span><span>${formatNaira(order.total)}</span></div>
      </div>
    `).join("");
  } catch (e) {
    console.error(e);
    body.innerHTML = `<div class="empty-state"><p>Couldn't load orders.<br/><span style="font-size:11px;color:var(--text-faint);word-break:break-word;">${escHtml(e.message)}</span></p></div>`;
  }
}

// ── Site settings tab ──────────────────────────────────
function renderSettingsTab() {
  const body = document.getElementById("ad-body");
  body.innerHTML = `
    <div class="settings-item">
      <h3><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>Remove old demo/seed products</h3>
      <p>Earlier builds of Tradehub included sample listings from a test seller ("Cfirbigets"). If any of those are still in your database, this will find and delete them permanently.</p>
      <button class="ad-cleanup-btn" onclick="handleCleanupDemo()">Find &amp; Remove Demo Products</button>
      <div id="cleanup-results" style="margin-top:12px;"></div>
    </div>
  `;
}

window.handleCleanupDemo = async function () {
  const resultsEl = document.getElementById("cleanup-results");
  resultsEl.innerHTML = '<div class="spinner-wrap" style="padding:20px 0;"><div class="spinner"></div></div>';

  try {
    const all = await getAllProductsForAdmin();
    const found = all.filter(p => p.sellerName === "Cfirbigets");

    if (!found.length) {
      resultsEl.innerHTML = `<div class="empty-state"><p>No demo products found. Your catalog is clean.</p></div>`;
      return;
    }

    resultsEl.innerHTML = `
      <div class="ad-card">
        <p style="font-size:13px;color:var(--text);margin-bottom:12px;"><strong>${found.length}</strong> demo product${found.length !== 1 ? 's' : ''} found:</p>
        <ul style="font-size:12px;color:var(--text-dim);margin-bottom:14px;padding-left:18px;">
          ${found.map(p => `<li>${escHtml(p.name)}</li>`).join("")}
        </ul>
        <button class="ad-btn reject" style="width:100%;" onclick="confirmDeleteDemo()">Delete All ${found.length} Permanently</button>
      </div>
    `;
    window.__demoProductIds = found.map(p => p.id);
  } catch (e) {
    resultsEl.innerHTML = `<div class="empty-state"><p>Couldn't search for demo products.<br/><span style="font-size:11px;color:var(--text-faint);">${escHtml(e.message)}</span></p></div>`;
  }
};

window.confirmDeleteDemo = async function () {
  if (!(await confirmDialog(`Permanently delete ${window.__demoProductIds.length} demo product(s)? This can't be undone.`, { confirmLabel: "Delete" }))) return;
  try {
    await Promise.all(window.__demoProductIds.map(id => deleteProduct(id)));
    toastMsg(`Deleted ${window.__demoProductIds.length} demo product(s)`);
    cachedAll = null;
    renderSettingsTab();
  } catch (e) {
    toastMsg("Couldn't delete: " + e.message);
  }
};

// ── Subscriptions tab ──────────────────────────────────
// Lists every seller/both account with their trial/paid status, and
// lets the admin override it (start/restart a trial, manually grant
// paid days for e.g. a bank-transfer payment, or end access early).
function formatSubDate(ms) {
  if (!ms) return "—";
  return new Date(ms).toLocaleDateString("en-NG", { day: "numeric", month: "short", year: "numeric" });
}

async function renderSubsTab() {
  const body = document.getElementById("ad-body");
  try {
    // getAllSellers() (GET /api/subscriptions/sellers) already returns
    // each seller bundled with their OWN subscription + accessState,
    // computed server-side — no need to fetch per seller here. (A
    // per-seller call to getSubscription() would be wrong anyway: that
    // function always resolves to the logged-in admin's own
    // subscription via /api/subscriptions/me, not the seller being
    // rendered.)
    const sellers = await getAllSellers();
    if (!sellers.length) {
      body.innerHTML = `<div class="empty-state"><p>No seller accounts yet.</p></div>`;
      return;
    }

    const rows = sellers.map(seller => ({
      seller, sub: seller.subscription, state: seller.accessState
    }));

    body.innerHTML = rows.map(({ seller, sub, state }) => {
      let detail = "No subscription record.";
      if (state === "trial") detail = `Trial ends ${formatSubDate(sub.trialEnd)}`;
      else if (state === "active") detail = `Active — renews ${formatSubDate(sub.currentPeriodEnd)}`;
      else if (state === "expired") detail = sub.status === "trial"
        ? `Trial ended ${formatSubDate(sub.trialEnd)}`
        : `Lapsed ${formatSubDate(sub.currentPeriodEnd)}`;

      return `
        <div class="sub-card">
          <div class="sub-top-row">
            <span class="sub-name">${escHtml(seller.name || seller.id)} <span style="color:var(--text-faint);font-weight:500;">@${escHtml(seller.id)}</span></span>
            <span class="sub-pill ${state}">${state}</span>
          </div>
          <div class="sub-detail">${detail}</div>
          <div class="sub-actions">
            <button class="sub-btn primary" onclick="handleStartTrial('${seller.id}')">Start/Restart 14-Day Trial</button>
            <button class="sub-btn" onclick="handleGrantPaid('${seller.id}')">Grant 30 Paid Days</button>
            <button class="sub-btn danger" onclick="handleEndAccess('${seller.id}')">End Access</button>
          </div>
        </div>
      `;
    }).join("");
  } catch (e) {
    console.error(e);
    body.innerHTML = `<div class="empty-state"><p>Couldn't load subscriptions.<br/><span style="font-size:11px;color:var(--text-faint);word-break:break-word;">${escHtml(e.message)}</span></p></div>`;
  }
}

window.handleStartTrial = async function (username) {
  if (!(await confirmDialog(`Start a fresh 14-day trial for @${username}? This resets their trial countdown.`, { confirmLabel: "Start Trial", danger: false }))) return;
  try {
    await adminStartTrial(username, 14);
    toastMsg(`14-day trial started for @${username}`);
    await renderSubsTab();
  } catch (e) {
    toastMsg("Couldn't start trial: " + e.message);
  }
};

window.handleGrantPaid = async function (username) {
  if (!(await confirmDialog(`Grant @${username} 30 days of paid access (e.g. for an offline/bank transfer payment)?`, { confirmLabel: "Grant Access", danger: false }))) return;
  try {
    await adminGrantPaidDays(username, 30);
    toastMsg(`30 paid days granted to @${username}`);
    await renderSubsTab();
  } catch (e) {
    toastMsg("Couldn't grant access: " + e.message);
  }
};

window.handleEndAccess = async function (username) {
  if (!(await confirmDialog(`End @${username}'s seller access now? They won't be able to list new items until they subscribe again.`, { confirmLabel: "End Access" }))) return;
  try {
    await adminEndAccess(username);
    toastMsg(`Access ended for @${username}`);
    await renderSubsTab();
  } catch (e) {
    toastMsg("Couldn't end access: " + e.message);
  }
};

// ── Users tab ──────────────────────────────────────────
// Every account, with the ability to promote/demote admin status or
// delete the account. Accounts flagged "protected" (invincible) show
// a badge instead of action buttons — enforced server-side too
// (routes/api/users.js), so this is a UI convenience, not the real
// gate. currentUsername lets the acting admin see, but not act on,
// their own row where that would be confusing (e.g. deleting yourself).
let currentUsername = null;

function invincibleBadgeSvg() {
  return `<svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4z"/></svg>`;
}

async function renderUsersTab() {
  const body = document.getElementById("ad-body");
  try {
    const users = await getAllUsers();
    if (!users.length) {
      body.innerHTML = `<div class="empty-state"><p>No accounts yet.</p></div>`;
      return;
    }

    body.innerHTML = users.map(u => {
      const isSelf = u.username === currentUsername;
      const badges = [
        u.isAdmin ? `<span class="usr-pill admin">Admin</span>` : "",
        u.isProtected ? `<span class="usr-pill invincible">${invincibleBadgeSvg()} Invincible</span>` : ""
      ].join("");

      let actions;
      if (u.isProtected) {
        actions = `<span style="font-size:11px;color:var(--text-faint);">Protected — can't be changed here</span>`;
      } else if (isSelf) {
        actions = `<span style="font-size:11px;color:var(--text-faint);">This is your account</span>`;
      } else {
        actions = `
          ${u.isAdmin
            ? `<button class="usr-btn" onclick="handleDemote('${u.username}')">Remove Admin</button>`
            : `<button class="usr-btn primary" onclick="handlePromote('${u.username}')">Make Admin</button>`
          }
          <button class="usr-btn danger" onclick="handleDeleteUser('${u.username}')">Delete Account</button>
        `;
      }

      return `
        <div class="usr-card">
          <div class="usr-top-row">
            <span class="usr-name">${escHtml(u.name || u.username)} <span class="usr-handle">@${escHtml(u.username)}</span></span>
            <div class="usr-badges">${badges}</div>
          </div>
          <div class="usr-detail">${escHtml(u.role || "buyer")}${u.phone ? " · " + escHtml(u.phone) : ""}</div>
          <div class="usr-actions">${actions}</div>
        </div>
      `;
    }).join("");
  } catch (e) {
    console.error(e);
    body.innerHTML = `<div class="empty-state"><p>Couldn't load users.<br/><span style="font-size:11px;color:var(--text-faint);word-break:break-word;">${escHtml(e.message)}</span></p></div>`;
  }
}

window.handlePromote = async function (username) {
  if (!(await confirmDialog(`Give @${username} admin access?`, { confirmLabel: "Make Admin", danger: false }))) return;
  try {
    await promoteUser(username);
    toastMsg(`@${username} is now an admin`);
    await renderUsersTab();
  } catch (e) {
    toastMsg("Couldn't promote: " + e.message);
  }
};

window.handleDemote = async function (username) {
  if (!(await confirmDialog(`Remove admin access from @${username}?`, { confirmLabel: "Remove Admin" }))) return;
  try {
    await demoteUser(username);
    toastMsg(`Admin access removed from @${username}`);
    await renderUsersTab();
  } catch (e) {
    toastMsg("Couldn't remove admin: " + e.message);
  }
};

window.handleDeleteUser = async function (username) {
  if (!(await confirmDialog(`Permanently delete @${username}'s account? This can't be undone.`, { confirmLabel: "Delete Account" }))) return;
  try {
    await deleteUser(username);
    toastMsg(`@${username} deleted`);
    await renderUsersTab();
  } catch (e) {
    toastMsg("Couldn't delete: " + e.message);
  }
};

init();
</script>
</body>
</html>
