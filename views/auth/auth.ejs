<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>Tradehub — Sign In</title>
<link rel="stylesheet" href="/css/style.css"/>
<style>
  .screen { display: none; flex-direction: column; flex: 1; min-height: 0; }
  .screen.active { display: flex; }

  .auth-top {
    background: var(--blue);
    padding: 56px 24px 40px;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
  }
  .auth-badge {
    width: 70px; height: 70px; border-radius: 20px;
    background: #fff; display: flex; align-items: center; justify-content: center;
    margin-bottom: 16px;
    box-shadow: 0 6px 24px rgba(0,0,0,.15);
  }
  .auth-badge svg { width: 38px; height: 38px; }
  .auth-brand { font-size: 28px; font-weight: 900; color: #fff; margin-bottom: 6px; }
  .auth-tagline { font-size: 13.5px; color: rgba(255,255,255,.82); line-height: 1.5; }

  .auth-body { flex: 1; padding: 32px 24px 24px; overflow-y: auto; min-height: 0; }
  .auth-title { font-size: 20px; font-weight: 800; color: var(--text); margin-bottom: 6px; }
  .auth-sub { font-size: 13.5px; color: var(--text-dim); margin-bottom: 26px; line-height: 1.6; }

  .field { margin-bottom: 18px; }
  .field label { display: block; font-size: 13px; color: var(--text-dim); font-weight: 600; margin-bottom: 7px; }
  .field-box {
    background: var(--surface); border: 1.5px solid var(--border);
    border-radius: var(--r-md); display: flex; align-items: center;
    gap: 10px; padding: 14px 16px; transition: border-color .15s;
  }
  .field-box:focus-within { border-color: var(--blue); }
  .field-box input {
    background: transparent; border: none; outline: none;
    color: var(--text); font-size: 15px; flex: 1;
  }
  .field-box input::placeholder { color: var(--text-faint); }
  .field-box .at { color: var(--text-faint); font-weight: 700; }
  .field-hint { font-size: 11.5px; color: var(--text-faint); margin-top: 6px; line-height: 1.5; }
  .field-error { font-size: 12.5px; color: var(--danger); margin-top: 6px; display: none; }
  .field-error.show { display: block; }

  .btn {
    width: 100%; border: none; border-radius: var(--r-md); padding: 15px;
    font-size: 15px; font-weight: 700; display: flex; align-items: center;
    justify-content: center; gap: 8px; cursor: pointer;
    transition: opacity .15s, transform .1s;
  }
  .btn:active { transform: scale(.98); }
  .btn:disabled { opacity: .5; cursor: not-allowed; }
  .btn-primary { background: var(--blue); color: #fff; }
  .btn-primary:not(:disabled):hover { opacity: .9; }

  .switch-row { text-align: center; font-size: 13px; color: var(--text-dim); margin-top: 22px; }
  .switch-row button { background: none; border: none; color: var(--blue); font-weight: 700; font-size: 13px; cursor: pointer; }

  .fine-print { font-size: 11.5px; color: var(--text-faint); text-align: center; margin-top: 20px; line-height: 1.7; }

  /* ── Account setup extras (avatar, role) ── */
  .avatar-picker-row { display: flex; align-items: center; gap: 16px; margin-bottom: 22px; }
  .avatar-preview {
    width: 64px; height: 64px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; font-weight: 800; color: #fff; flex-shrink: 0;
    background: var(--blue);
  }
  .color-row { display: flex; gap: 9px; flex-wrap: wrap; }
  .color-dot { width: 26px; height: 26px; border-radius: 50%; cursor: pointer; border: 2.5px solid transparent; }
  .color-dot.selected { border-color: var(--text); }

  .role-cards { display: flex; gap: 10px; margin-bottom: 6px; }
  .role-card {
    flex: 1; background: var(--surface); border: 2px solid var(--border);
    border-radius: var(--r-lg); padding: 14px 8px; text-align: center; cursor: pointer;
    transition: border-color .15s, background .15s;
  }
  .role-card.selected { border-color: var(--blue); background: #EBF5FF; }
  .role-card .role-icon { font-size: 22px; margin-bottom: 6px; }
  .role-card .role-title { font-size: 12.5px; font-weight: 800; color: var(--text); }
  .role-card .role-desc { font-size: 10px; color: var(--text-dim); line-height: 1.3; margin-top: 2px; }

  .spinner { width: 20px; height: 20px; border: 2.5px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="app safe-top safe-bottom">

  <!-- ══════════════════════════════
       SCREEN 1 — LOG IN
  ══════════════════════════════ -->
  <div class="screen active" id="screen-login">
    <div class="auth-top">
      <div class="auth-badge">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" fill="#3DA9FC"/>
          <path d="M3 6h18" stroke="#fff" stroke-width="1.5"/>
          <path d="M16 10a4 4 0 01-8 0" stroke="#fff" stroke-width="1.5" fill="none"/>
        </svg>
      </div>
      <div class="auth-brand">Tradehub</div>
      <div class="auth-tagline">Buy and sell anything.<br/>Connect with thousands of buyers.</div>
    </div>

    <div class="auth-body">
      <div class="auth-title">Welcome back</div>
      <div class="auth-sub">Log in with your username and password.</div>

      <div class="field">
        <label>Username</label>
        <div class="field-box">
          <span class="at">@</span>
          <input type="text" id="login-username" placeholder="yourname" autocomplete="username"
            oninput="this.value=this.value.toLowerCase().replace(/[^a-z0-9_.]/g,'')"
            onkeydown="if(event.key==='Enter')document.getElementById('login-password').focus()"/>
        </div>
      </div>

      <div class="field">
        <label>Password</label>
        <div class="field-box">
          <input type="password" id="login-password" placeholder="Your password" autocomplete="current-password"
            onkeydown="if(event.key==='Enter')handleLogin()"/>
        </div>
        <div class="field-error" id="login-error"></div>
      </div>

      <button class="btn btn-primary" id="btn-login" onclick="handleLogin()">
        Log In
      </button>

      <div class="switch-row">
        New to Tradehub?
        <button onclick="showScreen('screen-signup')">Create an account</button>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════
       SCREEN 2 — SIGN UP
  ══════════════════════════════ -->
  <div class="screen" id="screen-signup">
    <div class="auth-top" style="padding:40px 24px 32px;">
      <div class="auth-badge" style="width:56px;height:56px;">
        <svg viewBox="0 0 24 24" fill="none" width="30" height="30">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" fill="#3DA9FC"/>
          <path d="M3 6h18" stroke="#fff" stroke-width="1.5"/>
          <path d="M16 10a4 4 0 01-8 0" stroke="#fff" stroke-width="1.5" fill="none"/>
        </svg>
      </div>
      <div class="auth-brand" style="font-size:22px;">Create Your Account</div>
    </div>

    <div class="auth-body">
      <div class="avatar-picker-row">
        <div class="avatar-preview" id="avatar-preview">?</div>
        <div>
          <div class="field-hint" style="margin-bottom:8px;">Avatar color</div>
          <div class="color-row" id="color-row">
            <div class="color-dot selected" style="background:#3DA9FC;" data-color="#3DA9FC"></div>
            <div class="color-dot" style="background:#FF5C8A;" data-color="#FF5C8A"></div>
            <div class="color-dot" style="background:#FF7A59;" data-color="#FF7A59"></div>
            <div class="color-dot" style="background:#1FAE6E;" data-color="#1FAE6E"></div>
            <div class="color-dot" style="background:#7C3AED;" data-color="#7C3AED"></div>
            <div class="color-dot" style="background:#FFB23E;" data-color="#FFB23E"></div>
          </div>
        </div>
      </div>

      <div class="field">
        <label>Full name</label>
        <div class="field-box">
          <input type="text" id="signup-name" placeholder="e.g. Tolu Bello" maxlength="50" oninput="updateAvatarPreview()"/>
        </div>
        <div class="field-error" id="err-name"></div>
      </div>

      <div class="field">
        <label>Username</label>
        <div class="field-box">
          <span class="at">@</span>
          <input type="text" id="signup-username" placeholder="yourname" maxlength="30" autocomplete="off" spellcheck="false"
            oninput="this.value=this.value.toLowerCase().replace(/[^a-z0-9_.]/g,'')"/>
        </div>
        <div class="field-hint">Lowercase letters, numbers, . and _ only. This is how you'll log in.</div>
        <div class="field-error" id="err-username"></div>
      </div>

      <div class="field">
        <label>Phone number</label>
        <div class="field-box">
          <input type="tel" id="signup-phone" placeholder="0810 000 0000" inputmode="tel" maxlength="20"/>
        </div>
        <div class="field-hint">Shown on your listings if you sell, so buyers can reach you.</div>
        <div class="field-error" id="err-phone"></div>
      </div>

      <div class="field">
        <label>Password</label>
        <div class="field-box">
          <input type="password" id="signup-password" placeholder="At least 4 characters" autocomplete="new-password"/>
        </div>
        <div class="field-error" id="err-password"></div>
      </div>

      <div class="field">
        <label>Confirm password</label>
        <div class="field-box">
          <input type="password" id="signup-password2" placeholder="Re-enter password" autocomplete="new-password"/>
        </div>
        <div class="field-error" id="err-password2"></div>
      </div>

      <div class="field">
        <label>I want to</label>
        <div class="role-cards" id="role-cards">
          <div class="role-card selected" data-role="buyer">
            <div class="role-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg></div>
            <div class="role-title">Buy</div>
          </div>
          <div class="role-card" data-role="seller">
            <div class="role-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5"/><path d="M4 9v10a1 1 0 001 1h14a1 1 0 001-1V9"/><path d="M9 21v-6h6v6"/><path d="M3 9a3 3 0 006 0 3 3 0 006 0 3 3 0 006 0"/></svg></div>
            <div class="role-title">Sell</div>
          </div>
          <div class="role-card" data-role="both">
            <div class="role-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 014-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg></div>
            <div class="role-title">Both</div>
          </div>
        </div>
      </div>

      <button class="btn btn-primary" id="btn-signup" onclick="handleSignup()" style="margin-top:6px;">
        Create Account
      </button>

      <div class="switch-row">
        Already have an account?
        <button onclick="showScreen('screen-login')">Log in</button>
      </div>

      <div class="fine-print">
        By continuing, you agree to Tradehub's Terms of Service and Privacy Policy.
      </div>
    </div>
  </div>

</div>

<div class="toast" id="toast"></div>

<script type="module">
import { login, createUser, getCurrentUser } from "/js/auth.js";

let selectedColor = "#3DA9FC";
let selectedRole  = "buyer";

// ── Already logged in? Go straight to home ──
getCurrentUser().then(user => {
  if (user) window.location.href = "/";
}).catch(() => {});

// ── Utils ──────────────────────────────────────────────
window.showScreen = function (id) {
  document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
  window.scrollTo(0, 0);
};

function toastMsg(msg, dur = 2500) {
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.classList.add("show");
  setTimeout(() => el.classList.remove("show"), dur);
}

function setBtnLoad(btn, loading, label) {
  btn.disabled = loading;
  btn.innerHTML = loading ? '<div class="spinner"></div>' : label;
}

function showErr(id, msg) {
  const el = document.getElementById(id);
  el.textContent = msg;
  el.classList.add("show");
}
function clearErrs() {
  document.querySelectorAll(".field-error").forEach(e => { e.textContent = ""; e.classList.remove("show"); });
}

// ── Avatar preview ──────────────────────────────────────
window.updateAvatarPreview = function () {
  const name = document.getElementById("signup-name").value.trim();
  const preview = document.getElementById("avatar-preview");
  preview.style.background = selectedColor;
  preview.textContent = name ? name.split(" ").map(w => w[0]).join("").slice(0, 2).toUpperCase() : "?";
};

document.getElementById("color-row").addEventListener("click", e => {
  if (!e.target.classList.contains("color-dot")) return;
  document.querySelectorAll(".color-dot").forEach(d => d.classList.remove("selected"));
  e.target.classList.add("selected");
  selectedColor = e.target.dataset.color;
  updateAvatarPreview();
});

document.getElementById("role-cards").addEventListener("click", e => {
  const card = e.target.closest(".role-card");
  if (!card) return;
  document.querySelectorAll(".role-card").forEach(c => c.classList.remove("selected"));
  card.classList.add("selected");
  selectedRole = card.dataset.role;
});

// ── Log in ──────────────────────────────────────────────
window.handleLogin = async function () {
  clearErrs();
  const username = document.getElementById("login-username").value.trim();
  const password = document.getElementById("login-password").value;
  const btn = document.getElementById("btn-login");

  if (!username) { showErr("login-error", "Enter your username."); return; }
  if (!password) { showErr("login-error", "Enter your password."); return; }

  setBtnLoad(btn, true);
  try {
    const user = await login(username, password);
    toastMsg(`Welcome back, ${user.name}!`);
    setTimeout(() => window.location.href = "/", 800);
  } catch (e) {
    showErr("login-error", e.message);
    setBtnLoad(btn, false, "Log In");
  }
};

// ── Sign up ─────────────────────────────────────────────
window.handleSignup = async function () {
  clearErrs();
  const name      = document.getElementById("signup-name").value.trim();
  const username  = document.getElementById("signup-username").value.trim();
  const phone     = document.getElementById("signup-phone").value.trim();
  const password  = document.getElementById("signup-password").value;
  const password2 = document.getElementById("signup-password2").value;
  const btn = document.getElementById("btn-signup");

  let hasError = false;
  if (!name) { showErr("err-name", "Enter your name."); hasError = true; }
  if (!username || username.length < 3) { showErr("err-username", "Username must be at least 3 characters."); hasError = true; }
  if (!phone || phone.replace(/\D/g, "").length < 10) { showErr("err-phone", "Enter a valid phone number."); hasError = true; }
  if (!password || password.length < 4) { showErr("err-password", "Password must be at least 4 characters."); hasError = true; }
  if (password !== password2) { showErr("err-password2", "Passwords don't match."); hasError = true; }
  if (hasError) return;

  setBtnLoad(btn, true);
  try {
    const user = await createUser(username, password, name, phone, selectedRole, selectedColor);
    toastMsg(`Welcome to Tradehub, ${name}!`);
    setTimeout(() => window.location.href = "/", 900);
  } catch (e) {
    showErr("err-username", e.message);
    setBtnLoad(btn, false, "Create Account");
  }
};
</script>
</body>
</html>
