<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>Tradehub — My Listings</title>
<link rel="stylesheet" href="/css/style.css"/>
<style>
  .ml-header {
    padding: 16px; background: var(--surface); border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 12px; flex-shrink: 0;
  }
  .ml-header h1 { font-size: 16.5px; font-weight: 800; color: var(--text); flex: 1; }
  .ml-add-btn {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--accent-grad); display: flex; align-items: center; justify-content: center;
  }

  .ml-body { flex: 1; padding: 14px 16px 20px; overflow-y: auto; }

  .ml-card {
    display: flex; gap: 12px; background: var(--surface);
    border-radius: var(--r-lg); padding: 12px; margin-bottom: 10px;
    box-shadow: 0 1px 4px rgba(20,30,50,.05);
  }
  .ml-thumb {
    width: 64px; height: 64px; border-radius: var(--r-sm);
    background: linear-gradient(160deg, #dde6f0, #c5d4e6);
    flex-shrink: 0; overflow: hidden;
  }
  .ml-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .ml-info { flex: 1; min-width: 0; }
  .ml-name { font-size: 12.5px; font-weight: 700; color: var(--text); line-height: 1.35; margin-bottom: 4px; }
  .ml-price { font-size: 14px; font-weight: 800; color: var(--accent-end); margin-bottom: 4px; }
  .ml-meta { font-size: 10.5px; color: var(--text-faint); margin-top: 4px; }
  .ml-status-badge { font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: var(--r-pill); }
  .ml-status-badge.approved { background: var(--success-bg); color: var(--success); }
  .ml-status-badge.pending { background: #FFF3E0; color: #C17A00; }
  .ml-status-badge.rejected { background: #FFE5EC; color: var(--danger); }
  .ml-rejection-note { font-size: 10.5px; color: var(--danger); margin-top: 4px; line-height: 1.4; }
  .ml-actions { display: flex; flex-direction: column; gap: 6px; align-items: flex-end; justify-content: center; }
  .ml-action-btn {
    width: 30px; height: 30px; border-radius: 8px; background: var(--field-bg);
    display: flex; align-items: center; justify-content: center;
  }
  .ml-action-btn.danger svg { color: var(--danger); }
  .ml-action-btn svg { color: var(--blue); }

  .empty-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 24px; text-align: center; }
  .empty-state svg { width: 56px; height: 56px; color: var(--border); margin-bottom: 16px; }
  .empty-state p { color: var(--text-dim); font-size: 14px; margin-bottom: 20px; line-height: 1.6; }
  .empty-state .cta-btn { background: var(--accent-grad); color: #fff; font-weight: 700; font-size: 13.5px; padding: 12px 26px; border-radius: var(--r-pill); }

  .spinner-wrap { flex: 1; display: flex; align-items: center; justify-content: center; }
  .spinner { width: 28px; height: 28px; border: 3px solid var(--border); border-top-color: var(--blue); border-radius: 50%; animation: spin .7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="app safe-top safe-bottom">

  <div class="ml-header">
    <button onclick="window.location.href='/profile'" style="display:flex;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16213A" stroke-width="2.5"><path d="M19 12H5M5 12l7-7M5 12l7 7"/></svg>
    </button>
    <h1>My Listings</h1>
    <button class="ml-add-btn" onclick="window.location.href='/sell'">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
    </button>
  </div>

  <div id="loading" class="spinner-wrap"><div class="spinner"></div></div>
  <div id="listings-body" class="ml-body hidden"></div>
  <div id="empty-state" class="empty-state hidden">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
    <p>You haven't listed anything yet.<br/>Start selling on Tradehub today.</p>
    <button class="cta-btn" onclick="window.location.href='/sell'">List Your First Item</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script type="module">
import { getCurrentUser } from "/js/auth.js";
import { getMyProducts, deleteProduct } from "/js/products.js";

function toastMsg(msg, dur = 2200) {
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.classList.add("show");
  setTimeout(() => el.classList.remove("show"), dur);
}

function formatNaira(n) { return "₦" + Number(n).toLocaleString("en-NG"); }
function escHtml(s) { return String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

const ICON_CHECK = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;margin-right:3px;"><polyline points="20 6 9 17 4 12"/></svg>';
const ICON_X = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;margin-right:3px;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
const ICON_CLOCK = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;margin-right:3px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';

function statusLabel(status) {
  if (status === "approved") return ICON_CHECK + "Live";
  if (status === "rejected") return ICON_X + "Rejected";
  return ICON_CLOCK + "Pending review";
}

async function init() {
  const user = await getCurrentUser();
  if (!user) { window.location.href = "/auth"; return; }
  if (user.role === "buyer") {
    toastMsg("This page is for sellers. Switch your role in Edit Profile to access it.");
    setTimeout(() => window.location.href = "/profile", 1800);
    return;
  }

  try {
    const products = await getMyProducts(user.id);
    document.getElementById("loading").classList.add("hidden");

    if (!products.length) {
      document.getElementById("empty-state").classList.remove("hidden");
      document.getElementById("empty-state").style.display = "flex";
      return;
    }

    const body = document.getElementById("listings-body");
    body.classList.remove("hidden");
    body.innerHTML = products.map(p => `
      <div class="ml-card">
        <div class="ml-thumb">${p.imageUrl ? `<img src="${p.imageUrl}"/>` : ""}</div>
        <div class="ml-info">
          <div class="ml-name">${escHtml(p.name)}</div>
          <div class="ml-price">${formatNaira(p.price)}</div>
          <div class="ml-meta">
            <span class="ml-status-badge ${p.status || 'pending'}">${statusLabel(p.status)}</span>
            ${p.status === 'approved' ? ` · ${p.sold || 0} sold` : ''}
          </div>
          ${p.status === 'rejected' && p.rejectionReason ? `<div class="ml-rejection-note">Reason: ${escHtml(p.rejectionReason)}</div>` : ''}
        </div>
        <div class="ml-actions">
          <button class="ml-action-btn" onclick="window.location.href='/product/${p.id}'" aria-label="View">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
          <button class="ml-action-btn danger" onclick="deleteListing('${p.id}', this)" aria-label="Delete">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
          </button>
        </div>
      </div>
    `).join("");
  } catch (e) {
    document.getElementById("loading").classList.add("hidden");
    console.error(e);
    const empty = document.getElementById("empty-state");
    empty.classList.remove("hidden");
    empty.style.display = "flex";
    empty.querySelector("p").innerHTML = `Couldn't load your listings.<br/><span style="font-size:11px;color:var(--text-faint);word-break:break-word;">${escHtml(e.message)}</span>`;
  }
}

window.deleteListing = async function (productId, btnEl) {
  if (!confirm("Remove this listing? This can't be undone.")) return;
  try {
    await deleteProduct(productId);
    btnEl.closest(".ml-card").remove();
    toastMsg("Listing removed");
    if (!document.querySelectorAll(".ml-card").length) {
      document.getElementById("listings-body").classList.add("hidden");
      document.getElementById("empty-state").classList.remove("hidden");
      document.getElementById("empty-state").style.display = "flex";
    }
  } catch (e) {
    toastMsg("Couldn't delete: " + e.message);
  }
};

init();
</script>
</body>
</html>
